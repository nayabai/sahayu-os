# GEMINI_API_KEY: Required for Gemini AI API calls (Job parsing, AI description, translation, smart match explanation)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# DATABASE_URL: PostgreSQL connection string (when connecting to external database)
DATABASE_URL=""

# GOOGLE_MAPS_API_KEY: For distance matrix, geocoding and live map views
GOOGLE_MAPS_API_KEY=""

# RAZORPAY_KEY_ID: Razorpay Indian payment gateway key ID
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Razorpay Indian payment gateway secret
RAZORPAY_KEY_SECRET=""

# WHATSAPP_BUSINESS_TOKEN: Meta WhatsApp Cloud API Bearer token for alerts
WHATSAPP_BUSINESS_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Sender phone number ID for WhatsApp Business notifications
WHATSAPP_PHONE_NUMBER_ID=""

# ==============================================================================
# SAHAYU OS - ZERO-CONFIG ENVIRONMENT TEMPLATE
# ==============================================================================
# All external APIs (Database, Google Maps, Razorpay, WhatsApp) have built-in
# native zero-configuration alternatives that work 100% out-of-the-box!
# You do NOT need to configure any external services to run this application.
# ==============================================================================

# GEMINI_API_KEY: Optional on self-hosted environments (automatically provided in AI Studio).
# Used for multilingual voice-to-text, translation, and AI job breakdown.
GEMINI_API_KEY=""

# APP_URL: Optional host URL (e.g., https://sahayu-os.onrender.com)
APP_URL=""

# ------------------------------------------------------------------------------
# OPTIONAL EXTERNAL INTEGRATIONS (Already have built-in alternatives)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL:
#    - Built-in Alternative: Persistent Local JSON Store (data/sahayu_db.json)
#    - Optional: Provide PostgreSQL URL if you want external cloud DB sync
# DATABASE_URL=""

# 2. GOOGLE_MAPS_API_KEY:
#    - Built-in Alternative: Free OpenStreetMap & Leaflet with Pune GIS Geocoding
#    - Optional: Only needed if you want Google Maps Platform JavaScript SDK
# GOOGLE_MAPS_API_KEY=""

# 3. RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET:
#    - Built-in Alternative: Native Dynamic UPI QR Code, GPay/PhonePe Deep Links,
#      Instant Digital Invoicing, and Multi-channel Payment Simulator
#    - Optional: Only needed if you want live Razorpay merchant checkout
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
